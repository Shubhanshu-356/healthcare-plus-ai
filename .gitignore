# ===========================
#  PYTHON / FLASK BACKEND
# ===========================
# Virtual Environments
venv/
.venv/
env/
.env

# Byte-compiled / Optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Flask instance folder (often used for local database files)
instance/
.webassets-cache

# Data files (The JSON files you are saving locally)
*.json
# Keep the sample/empty ones if you want, but usually, we ignore real user data
backend/*.json

# ===========================
#  REACT / NODE FRONTEND
# ===========================
# Dependencies
node_modules/
.pnp
.pnp.js

# Testing coverage
coverage/

# Production build output
build/
dist/

# Local Environment Variables (Secrets)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===========================
#  OPERATING SYSTEM / IDE
# ===========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log